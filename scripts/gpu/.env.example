# scripts/gpu/deploy.sh settings — copy to scripts/gpu/.env (git-ignored) and fill in.
# Artifact host: the box that keeps the 2.5 GB Groth16 prover files and the prebuilt binaries (our Azure VM).
ARTIFACT_HOST=local
# ARTIFACT_DIR=$HOME/gpu-artifacts   (default for local; ~270 MB: binaries + the ICICLE worker)
# or a server of ours (faster: it pushes to the box itself, zkey included):
# ARTIFACT_HOST=user@host
# ARTIFACT_DIR=gpu-artifacts
# ARTIFACT_SSH_OPTS="-i $HOME/.ssh/<key>"
# Groth16 engine on the box: icicle (GPU worker, ~5 s wrap; default) or native (reference CPU prover, ~19 s)
ENGINE=icicle
# zkotc-server settings on the GPU box (PORT is the container port; Vast maps it to a public one)
PORT=10100
PROVER_TOKEN=change-me            # same value as NEXT_PUBLIC_PROVER_TOKEN in web/.env.local
CORS_ORIGIN=http://localhost:3000,https://zkotc.vercel.app
DKIM_DNS=1
MAX_JOBS_QUEUED=8
# --switch: point the testnet escrow at the box's guest image id and the web app at the box
ESCROW_ID=CAFU5GMKM3UNZ3VLOZ7HX5HDFB7L7U2HM3UZLYLTFHIQLILIEYN5SDLG
STELLAR_IDENTITY=stellarpro
WEB_ENV=web/.env.local
# optional, for --test / prove-test.sh (quote values with spaces)
TEST_IBAN=TR330006100519786457841326
TEST_NAME="AD SOYAD"
# HTTPS front for the web app: Caddy on the artifact host, `handle_path /gpu/*` → box. deploy.sh re-points it each rental.
# PROXY_URL=   (legacy: a Caddy proxy on a server of ours; unset = Cloudflare quick tunnel on the box)
