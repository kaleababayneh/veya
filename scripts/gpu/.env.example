# scripts/gpu/deploy.sh settings — copy to scripts/gpu/.env (git-ignored) and fill in.
# Artifact host: the box that keeps the 2.5 GB Groth16 prover files and the prebuilt binaries (our Azure VM).
ARTIFACT_HOST=kaleab@4.239.243.216
ARTIFACT_DIR=gpu-artifacts
# zkotc-server settings on the GPU box (PORT is the container port; Vast maps it to a public one)
PORT=10100
PROVER_TOKEN=change-me            # same value as NEXT_PUBLIC_PROVER_TOKEN in web/.env.local
CORS_ORIGIN=http://localhost:3000
DKIM_DNS=1
MAX_JOBS_QUEUED=8
# --switch: point the testnet escrow at the box's guest image id and the web app at the box
ESCROW_ID=CBVLRH22A6QWM53NDMYKYTSNS5M7472IPLRJTSWCMU4WHBCX6JBZ5ERW
STELLAR_IDENTITY=stellarpro
WEB_ENV=web/.env.local
# optional, for --test / prove-test.sh (quote values with spaces)
TEST_IBAN=TR330006100519786457841326
TEST_NAME="AD SOYAD"
